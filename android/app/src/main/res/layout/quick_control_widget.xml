<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quick_control_widget_root"
    style="@style/Widget.LibrePods.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:theme="@style/Theme.LibrePods.AppWidgetContainer"
    tools:ignore="ContentDescription">

    <ImageView
        android:id="@+id/quick_control_widget_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_airpods"
        android:tint="@color/white" />

    <TextView
        android:id="@+id/quick_control_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="11sp" />
</LinearLayout>
